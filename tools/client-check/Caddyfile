# The edge in front of the check's stack, doing what the deployed edge does for a video host (core tools/edge): one path
# rewrite onto the core's anonymous root prefix, with the Host header passed upstream unchanged, which is what the core
# resolves the tenant from. Without this the clients would need a path prefix no PeerTube client can carry.
#
# TLS, because the module hands out https links (a file's, a watch page's) as every real video host has them; a client
# then dials 443. Caddy's own local authority signs the certificate, and the workflow hands that authority's root to
# each client's trust store for the run.
#
# The object store's door on 8333, under the same name and authority: the file door's 302 names it, and a client that
# cannot reach the runner's localhost (the app in an emulator) or send plain HTTP (its player) still gets the bytes.
# The Host header passes upstream unchanged, which is what the presigned link's signature covers.
tube.test {
	tls internal
	@tube path / /c/* /faq /api/v1/* /files/* /videos/watch/* /videos/embed/* /w/*
	handle @tube {
		rewrite * /peertube{uri}
		reverse_proxy api:8080
	}
	handle {
		respond 404
	}
}

tube.test:8333 {
	tls internal
	reverse_proxy seaweedfs:8333
}
