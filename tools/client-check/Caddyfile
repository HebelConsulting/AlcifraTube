# The edge in front of the check's stack, doing what the deployed edge does for a video host (core tools/edge): one path
# rewrite onto the core's anonymous root prefix, with the Host header passed upstream unchanged, which is what the core
# resolves the tenant from. Without this the clients would need a path prefix no PeerTube client can carry.
:80 {
	@tube path / /c/* /faq /api/v1/* /files/* /videos/watch/* /videos/embed/* /w/*
	handle @tube {
		rewrite * /peertube{uri}
		reverse_proxy api:8080
	}
	handle {
		respond 404
	}
}
