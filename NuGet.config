<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The core ABI is consumed as the PUBLISHED package (core ADRs 0751, 0834): this module is built out of the core
         repository on purpose, because consuming the published contract is what proves the contract suffices, which a
         ProjectReference could never do. Since the rename it is Alcifra.ModuleAbi, which the core publishes to
         nuget.org as well as to GitHub Packages; nuget.org needs no access grant (a renamed package on GitHub Packages
         is granted to each repository one id at a time). -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
