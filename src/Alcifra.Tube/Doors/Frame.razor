@* The document around every page, and what every page's style shares. *@
<!doctype html>
<html lang="@Language">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>@Title</title>
<style>
body{margin:0;font:16px/1.5 system-ui,sans-serif;color:#1d1d1f;background:#fff}
@@media (prefers-color-scheme:dark){body{color:#f5f5f7;background:#111}}
</style>
@Head
</head>
<body>
@ChildContent
</body>
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Language { get; set; } = "en";
    [Parameter] public RenderFragment? Head { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
