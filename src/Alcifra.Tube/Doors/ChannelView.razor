@* One channel's latest videos (ADR 0008). *@
<LandingFrame Title="@($"{Channel.Name} · {Account.Name}")" Heading="@Channel.Name" Intro="@Channel.Description">
    @if (Playlists.Count > 0)
    {
        <nav>@foreach (var playlist in Playlists)
        {
            <a href="@LandingPage.PlaylistAddress(AddressName, playlist.Name)">@playlist.Name</a>
        }</nav>
    }
    <VideoGrid Videos="Videos" ChannelNames="@(new Dictionary<Guid, string> { [Channel.FolderId] = AddressName })" Address="@LandingPage.ChannelAddress(AddressName)" Page="Page" />
    <nav><a href="/">@Account.Name</a><a href="/faq">FAQ</a></nav>
</LandingFrame>

@code {
    [Parameter, EditorRequired] public Channel Channel { get; set; } = null!;
    /// <summary>
    /// The REAL channel's name, which the addresses are built from — on a playlist's page the heading carries the
    /// playlist's name, so the channel's own name cannot be read off <see cref="Channel"/>.
    /// </summary>
    [Parameter, EditorRequired] public string AddressName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<PublishedVideo> Videos { get; set; } = [];
    [Parameter, EditorRequired] public Account Account { get; set; } = null!;
    /// <summary>The channel's playlists (ADR 0012), each linking its own page.</summary>
    [Parameter] public IReadOnlyList<Alcifra.ModuleAbi.ModuleDocument> Playlists { get; set; } = [];
    [Parameter, EditorRequired] public int Page { get; set; }
}
