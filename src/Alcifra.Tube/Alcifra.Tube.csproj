<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <Version>0.4.0</Version>
    <AssemblyName>Alcifra.Tube</AssemblyName>
    <RootNamespace>Alcifra.Tube</RootNamespace>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- The pages' views are Razor components (core docs/modules/tube/adr/0009); the module serves no static files. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Alcifra.Tube.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\manual\Alcifra-Tube-Module-Manual.pdf" LogicalName="Alcifra.Tube.Manual.pdf" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pinned exactly, never floating (core ADR 0789). -->
    <PackageReference Include="Alcifra.ModuleAbi" Version="2.1.0" />
  </ItemGroup>
</Project>
